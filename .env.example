# Copia este archivo como ".env" (sin .example) y cambia los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave

# Solo para HTTPS en la EC2 (docker compose --profile https up -d --build).
# Un dominio que apunte a la IP pública de la EC2, por ejemplo uno gratis de duckdns.org
DOMINIO=paolicias.duckdns.org
